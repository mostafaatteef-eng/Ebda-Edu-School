# ==============================================================================
# EBDA EDU — School Operations & Academic Monitoring System
# Environment Configuration Template
# ==============================================================================

# Google Apps Script Backend Web App API Endpoint (Optional / Cloud Sync)
# Format: https://script.google.com/macros/s/AKfycb.../exec
# (Public endpoint only — no secrets or database credentials required in frontend)
VITE_API_URL=

# GitHub Pages / Subdirectory Base Path (Default: auto-detected or './')
VITE_BASE_PATH=

# Operational Defaults
VITE_DEFAULT_SCHOOL_ID=badr
VITE_ACADEMIC_YEAR=2025 / 2026
VITE_DEFAULT_TERM=الفصل الدراسي الثاني
VITE_DEFAULT_LESSON_DURATION=60
VITE_TARGET_WEEKLY_LESSONS=25
VITE_MAX_UPLOAD_SIZE_MB=50

# AI Assistant Server-Side API Key (Optional)
GEMINI_API_KEY=

