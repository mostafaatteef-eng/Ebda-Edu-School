# Google Apps Script Backend Web App API Endpoint (Live Cloud Two-Way Sync)
# Format: https://script.google.com/macros/s/AKfycb.../exec
VITE_API_URL=https://script.google.com/macros/s/AKfycbzTPm---69OsRwrT4NAc5tSHaglS_GynvGbVWVWSUQnUk-ELFauyMiDyHdf5Yyzcln6/exec

# Connected Google Spreadsheet URL & ID (رابط شيت الإكسيل السحابي المربوط بالنظام)
# Direct Link: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
VITE_GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit
VITE_GOOGLE_SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms

# Two-Way Live Synchronization Settings (المزامنة اللحظية ثنائية الاتجاه مع الشيت)
# VITE_ENABLE_AUTO_SYNC: Enable continuous background polling & live sync (true / false)
VITE_ENABLE_AUTO_SYNC=true
# VITE_AUTO_SYNC_INTERVAL: Polling interval in seconds (default: 20s)
VITE_AUTO_SYNC_INTERVAL=20

# GitHub Pages / Subdirectory Base Path (Default: auto-detected or './')
VITE_BASE_PATH=

# Operational Defaults
VITE_DEFAULT_SCHOOL_ID=badr
VITE_ACADEMIC_YEAR=2025 / 2026
VITE_DEFAULT_TERM=الفصل الدراسي الثاني
VITE_DEFAULT_LESSON_DURATION=60
VITE_TARGET_WEEKLY_LESSONS=25
VITE_MAX_UPLOAD_SIZE_MB=50

# AI Assistant Server-Side API Key (Optional)
GEMINI_API_KEY=


